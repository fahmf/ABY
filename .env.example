# Supabase — ambil dari Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya server (jangan diekspos ke client). Untuk mutasi admin & pipeline ingest.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — untuk pipeline ingest (generasi kamus + penandaan akar)
GEMINI_API_KEY=
# ID model bisa diganti kapan saja (mis. gemini-3.5-flash / gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# URL situs publik (untuk sitemap & metadata Open Graph)
NEXT_PUBLIC_SITE_URL=https://localhost:3000
